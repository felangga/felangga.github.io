---
layout: compress
permalink: /feed.xml
# Atom Feed, reference: https://validator.w3.org/feed/docs/atom.html
#
# OVERRIDE milik site untuk assets/feed.xml versi theme Chirpy v7.5.0. Dua alasan:
#
#   1. Theme menulis `{% for post in site.posts limit: 5 %}` — angka 5 di-hardcode,
#      sehingga 108 post lama tidak pernah muncul di feed dan key `feed.posts_limit`
#      di _config.yml diabaikan sepenuhnya (jekyll-feed pun tidak terpasang di Gemfile).
#      Di sini limit dibaca dari `site.feed.posts_limit`.
#
#   2. <icon> dan <logo> theme menunjuk /assets/img/favicons/favicon.ico dan
#      favicon-96x96.png — itu favicon default Chirpy, bukan milik felangga,
#      sehingga feed reader menampilkan branding theme. Diarahkan ke favicon felangga.
#
# Struktur XML lainnya sengaja dipertahankan identik agar tetap lolos validator Atom.
---
{% capture source %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ "/" | absolute_url }}</id>
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.social.name }}</name>
    <uri>{{ "/" | absolute_url }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/>
  <link rel="alternate" type="text/html" hreflang="{{ site.alt_lang | default: site.lang }}"
    href="{{ '/' | absolute_url }}"/>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <rights> © {{ 'now' | date: '%Y' }} {{ site.social.name }} </rights>
  <icon>{{ site.baseurl }}/assets/img/favicons/felangga-96x96.png</icon>
  <logo>{{ site.baseurl }}/assets/img/favicons/felangga-512x512.png</logo>

{% assign feed_limit = site.feed.posts_limit | default: 20 %}
{% for post in site.posts limit: feed_limit %}
  {% assign post_absolute_url = post.url | absolute_url %}
  <entry>
    <title>{{ post.title }}</title>
    <link href="{{ post_absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
  {% if post.last_modified_at %}
    <updated>{{ post.last_modified_at | date_to_xmlschema }}</updated>
  {% else %}
    <updated>{{ post.date | date_to_xmlschema }}</updated>
  {% endif %}
    <id>{{ post_absolute_url }}</id>
    <content type="text/html" src="{{ post_absolute_url }}" />
    <author>
      <name>{{ post.author | default: site.social.name }}</name>
    </author>

  {% if post.categories %}
    {% for category in post.categories %}
    <category term="{{ category }}" />
    {% endfor %}
  {% endif %}

  <summary>{% include post-summary.html max_length=400 %}</summary>

  </entry>
{% endfor %}
</feed>
{% endcapture %}
{{ source | replace: '&', '&amp;' }}
